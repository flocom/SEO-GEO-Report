# Every variable is OPTIONAL: `docker compose up -d` works without any .env file.
# Copy to .env and uncomment what you need.

# Access password asked on the claude.ai login page, also accepted as
# "Authorization: Bearer <password>" (Claude Code, scripts).
# Default: a strong password is generated at first start, saved in the data
# volume (access-password.txt) and printed in `docker compose logs seogeo`.
#ACCESS_PASSWORD=choose-a-long-password

# Public base URL. Default: detected automatically from each request
# (X-Forwarded-Proto / X-Forwarded-Host / Forwarded / Host headers), which works
# behind Cloudflare Tunnel, Caddy, Traefik, nginx... Only set it if your proxy
# does not forward these headers.
#PUBLIC_URL=https://seo.example.com

# HTTP port inside the container (default 8080).
#PORT=8080

# Disable authentication entirely (local tests, or claude.ai "authless"
# connector). Anyone who can reach the server can then use it.
#AUTH_DISABLED=false

# Inline report viewer for hosts supporting MCP Apps (default true).
#MCP_APPS=true

# Check GitHub every 6 h for a new release and show it on the home page and
# in the logs (default true).
#UPDATE_CHECK=true

# Watchtower update check interval in seconds (default 3600 = 1 hour).
#WATCHTOWER_POLL_INTERVAL=3600

# Allow fetching site favicons from private / local addresses (intranet
# sites). Off by default (SSRF protection).
#FAVICON_ALLOW_PRIVATE=false

# Chromium executable used for the PDF export (auto-detected; the image ships Chromium).
#CHROME_PATH=/usr/bin/chromium

# Extra allowed OAuth redirect URI prefixes for other MCP clients, comma
# separated ("*" = any https URL). claude.ai, claude.com and localhost
# callbacks are always allowed.
#OAUTH_REDIRECT_ALLOWLIST=https://example-client.com/callback

# Token of a named Cloudflare Tunnel (see the commented cloudflared service in
# docker-compose.yml).
#TUNNEL_TOKEN=
